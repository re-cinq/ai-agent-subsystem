/// Generates the Python contract types (`packages/agent-contracts-python/src/agent_contracts/types_generated.py`)
/// from the same annotated `agentcore.crds` structs the other emitters read: Pydantic v2 models whose
/// aliases are the wire names, so `model_validate` reads what the API server returns and
/// `model_dump(by_alias=True, exclude_none=True)` writes what it accepts.
module pygen;

import std.algorithm : canFind, map;
import std.array : join, split;
import std.traits : isIntegral, isBoolean, isSomeString, isArray, isAssociativeArray,
	EnumMembers, ForeachType, ValueType;

import vibe.data.json : Json;

import described : describe;

import agentcore.crds.api_group : crGroup, crVersion, crApiVersion;
import agentcore.crds.registry : CrdEnums, CrdStructs, isKind;
import agentcore.crds.schema : descriptionOf, jsonNameOf, isRequired, pluralOf, shortNamesOf;

import wirenames : lowerSnake, upperSnake;

private enum indent = "    ";

/// Python keywords and BaseModel attributes a field name must not take.
private immutable string[] reservedNames = ["and", "as", "assert", "async", "await", "break", "class",
	"continue", "def", "del", "elif", "else", "except", "False", "finally", "for", "from", "global",
	"if", "import", "in", "is", "lambda", "None", "nonlocal", "not", "or", "pass", "raise", "return",
	"True", "try", "while", "with", "yield", "schema", "json", "dict", "copy", "construct", "validate",
	"fields"];

/// A Python attribute from a wire name: `stationRef` -> `station_ref`, `schema` -> `schema_`.
string pyField(string wire)
{
	const name = lowerSnake(wire);
	return reservedNames.canFind(name) ? name ~ "_" : name;
}

/// The Python type annotation for D type `FT`.
template pyType(FT)
{
	static if (is(FT == Json))
		enum pyType = "Any";
	else static if (is(FT == enum))
		enum pyType = FT.stringof;
	else static if (isIntegral!FT)
		enum pyType = "int";
	else static if (isBoolean!FT)
		enum pyType = "bool";
	else static if (isSomeString!FT)
		enum pyType = "str";
	else static if (isAssociativeArray!FT)
		enum pyType = "dict[str, " ~ pyType!(ValueType!FT) ~ "]";
	else static if (isArray!FT)
		enum pyType = "list[" ~ pyType!(ForeachType!FT) ~ "]";
	else static if (is(FT == struct))
		enum pyType = FT.stringof;
	else
		static assert(false, "pygen: unsupported field type " ~ FT.stringof);
}

/// A docstring line for `text`, or "" when there is none.
private string docstring(string text, string prefix)
{
	if (!text.length)
		return "";
	const lines = text.split("\n");
	if (lines.length == 1)
		return prefix ~ "\"\"\"" ~ text ~ "\"\"\"\n\n";
	return prefix ~ "\"\"\"" ~ lines.map!(line => line).join("\n" ~ prefix) ~ "\n" ~ prefix ~ "\"\"\"\n\n";
}

/// A `str` Enum whose unknown values answer the first member, like `CrdPolicy` does in D.
string emitPyEnum(E)()
{
	string s = "class " ~ E.stringof ~ "(str, Enum):\n";
	static foreach (member; EnumMembers!E)
		s ~= indent ~ upperSnake(cast(string) member) ~ " = \"" ~ cast(string) member ~ "\"\n";
	s ~= "\n" ~ indent ~ "@classmethod\n";
	s ~= indent ~ "def _missing_(cls, value: object) -> \"" ~ E.stringof ~ "\":\n";
	s ~= indent ~ indent ~ "return next(iter(cls))\n";
	return s;
}

/// A Pydantic model for `T`. A kind also gets its group, version, plural and short names as class
/// variables and defaults for `apiVersion` and `kind`.
string emitPyModel(T)()
{
	string s = "class " ~ T.stringof ~ "(_Model):\n" ~ docstring(descriptionOf!T, indent);
	static if (isKind!T)
	{
		s ~= indent ~ "PLURAL: ClassVar[str] = \"" ~ pluralOf!T ~ "\"\n";
		s ~= indent ~ "SHORT_NAMES: ClassVar[tuple[str, ...]] = ("
			~ shortNamesOf!T.map!(short_ => "\"" ~ short_ ~ "\", ").join ~ ")\n\n";
	}
	static foreach (property; describe!T.properties)
	{{
		alias member = __traits(getMember, T, property.name);
		enum wire = jsonNameOf!member;
		enum field = pyField(wire);
		enum type = pyType!(typeof(member));
		static if (isKind!T && wire == "apiVersion")
			s ~= indent ~ "api_version: str = Field(default=API_VERSION, alias=\"apiVersion\")\n";
		else static if (isKind!T && wire == "kind")
			s ~= indent ~ "kind: str = \"" ~ T.stringof ~ "\"\n";
		else static if (isRequired!member)
			s ~= indent ~ field ~ ": " ~ type ~ " = Field(alias=\"" ~ wire ~ "\")\n";
		else
			s ~= indent ~ field ~ ": " ~ type ~ " | None = Field(default=None, alias=\"" ~ wire ~ "\")\n";
		s ~= docstring(descriptionOf!member, indent);
	}}
	return s;
}

/// The full generated Python module.
string emitPyTypes()
{
	string s = "# Code generated by ai-agent-tsgen from the agentcore CRD structs. DO NOT EDIT.\n";
	s ~= "# Regenerate: make regen\n\n";
	s ~= "from enum import Enum\nfrom typing import Any, ClassVar\n\n";
	s ~= "from pydantic import BaseModel, ConfigDict, Field\n\n";
	s ~= "GROUP = \"" ~ crGroup ~ "\"\n";
	s ~= "VERSION = \"" ~ crVersion ~ "\"\n";
	s ~= "API_VERSION = \"" ~ crApiVersion ~ "\"\n\n\n";
	s ~= "class _Model(BaseModel):\n";
	s ~= indent ~ "\"\"\"Accepts wire names and Python names, and keeps fields it does not know.\"\"\"\n\n";
	s ~= indent ~ "model_config = ConfigDict(validate_by_name=True, validate_by_alias=True, extra=\"allow\")\n";
	static foreach (E; CrdEnums)
		s ~= "\n\n" ~ emitPyEnum!E();
	static foreach (T; CrdStructs)
		s ~= "\n\n" ~ emitPyModel!T();
	return s;
}

version (unittest) import fluent.asserts;

unittest // wire names become snake_case attributes that avoid keywords and BaseModel methods
{
	[pyField("stationRef"), pyField("headers_secret"), pyField("schema"), pyField("prUrl")]
		.should.equal(["station_ref", "headers_secret", "schema_", "pr_url"]);
}

@safe unittest // pyType maps each D type kind to its annotation
{
	import agentcore.crds.env_var : EnvVar;

	static assert(pyType!Json == "Any");
	static assert(pyType!int == "int");
	static assert(pyType!(string[string]) == "dict[str, str]");
	static assert(pyType!(EnvVar[]) == "list[EnvVar]");
}

unittest // an enum falls back to its first member for an unknown value
{
	import agentcore.crds.enums : OutputFormat;

	emitPyEnum!OutputFormat().should.equal("class OutputFormat(str, Enum):\n"
		~ "    TEXT = \"text\"\n    JSON = \"json\"\n    STREAM_JSON = \"stream-json\"\n\n"
		~ "    @classmethod\n    def _missing_(cls, value: object) -> \"OutputFormat\":\n"
		~ "        return next(iter(cls))\n");
}

unittest // a required field has no default; an optional one defaults to None; aliases are wire names
{
	import agentcore.crds.secret_ref : SecretRef;
	import agentcore.crds.station_spec : StationSpec;

	emitPyModel!SecretRef().should.contain("    ref: str = Field(alias=\"ref\")\n");
	emitPyModel!StationSpec().should.contain(
		"    deadline_minutes: int | None = Field(default=None, alias=\"deadlineMinutes\")\n");
}

unittest // a kind carries its plural, short names, apiVersion and kind
{
	import agentcore.crds.agent : Agent;

	const source = emitPyModel!Agent();
	[source.canFind("    PLURAL: ClassVar[str] = \"agents\"\n"),
		source.canFind("    SHORT_NAMES: ClassVar[tuple[str, ...]] = (\"agt\", )\n"),
		source.canFind("    api_version: str = Field(default=API_VERSION, alias=\"apiVersion\")\n"),
		source.canFind("    kind: str = \"Agent\"\n")].should.equal([true, true, true, true]);
}
