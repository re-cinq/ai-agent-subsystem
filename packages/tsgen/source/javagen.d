/// Generates the Java contract types (`packages/agent-contracts-java/.../types/*.java`)
/// from the same annotated `agentcore.crds` structs tsgen, gogen and crdgen read, so a
/// Java consumer gets types that cannot drift from the CRDs. The top-level kinds extend
/// fabric8's `CustomResource<Spec, Status>` and get a `List` type, which makes them usable
/// with any fabric8 `KubernetesClient`, including the one Spring Cloud Kubernetes injects.
///
/// Java wants one public type per file, so the emitter returns a map from file name to
/// content. The output is deterministic (declaration order, fixed indentation) so the
/// drift check is a plain directory diff.
module javagen;

import std.algorithm : canFind, map;
import std.array : join, split;
import std.ascii : isUpper, toUpper;
import std.string : toUpper_ = toUpper;
import std.traits : isIntegral, isBoolean, isSomeString, isArray, isAssociativeArray,
	EnumMembers, ForeachType, ValueType;

import vibe.data.json : Json;

import described : describe;

import agentcore.crds.api_group : crGroup, crVersion, crApiVersion;
import agentcore.crds.object_meta : ObjectMeta;
import agentcore.crds.registry : CrdEnums, CrdKinds, CrdStructs, isKind;
import agentcore.crds.schema : descriptionOf, jsonNameOf, isRequired, pluralOf, shortNamesOf;

/// The Java package the generated types live in.
enum javaPackage = "com.recinq.agentcontracts.types";

private enum banner = "// Code generated by ai-agent-tsgen from the agentcore CRD structs. DO NOT EDIT.\n"
	~ "// Regenerate: make regen\n\n";

private enum indent = "    ";

/// Java keywords a wire name could collide with as a field identifier.
private immutable string[] javaKeywords = ["abstract", "assert", "boolean", "break", "byte", "case",
	"catch", "char", "class", "const", "continue", "default", "do", "double", "else", "enum",
	"extends", "final", "finally", "float", "for", "goto", "if", "implements", "import",
	"instanceof", "int", "interface", "long", "native", "new", "package", "private", "protected",
	"public", "return", "short", "static", "strictfp", "super", "switch", "synchronized", "this",
	"throw", "throws", "transient", "try", "void", "volatile", "while"];

/// The words of a wire name: split on `_`, `-`, `.` and lower-to-upper boundaries.
private string[] wireWords(string wire)
{
	string[] words;
	string word;
	foreach (character; wire)
	{
		if (character == '_' || character == '-' || character == '.')
		{
			words ~= word;
			word = "";
			continue;
		}
		if (isUpper(character) && word.length)
		{
			words ~= word;
			word = "";
		}
		word ~= character;
	}
	words ~= word;
	return words;
}

private string capitalized(string word)
{
	return word.length ? cast(char) toUpper(word[0]) ~ word[1 .. $] : word;
}

/// A Java enum constant from a wire value: `stream-json` -> `STREAM_JSON`, `Succeeded` -> `SUCCEEDED`.
string javaConstant(string wire)
{
	return wireWords(wire).map!(toUpper_).join("_");
}

/// A Java field identifier from a wire name: `headers_secret` -> `headersSecret`; keywords get a
/// trailing underscore.
string javaField(string wire)
{
	const words = wireWords(wire);
	const name = words[0] ~ words[1 .. $].map!(capitalized).join;
	return javaKeywords.canFind(name) ? name ~ "_" : name;
}

/// The accessor suffix for a wire name: `headers_secret` -> `HeadersSecret`.
string javaAccessor(string wire)
{
	return wireWords(wire).map!(capitalized).join;
}

/// The Java type expression for D type `FT`. Numbers and booleans are boxed so an unset
/// field stays `null` and the API server's schema default applies.
template javaType(FT)
{
	static if (is(FT == Json))
		enum javaType = "JsonNode";
	else static if (is(FT == enum))
		enum javaType = FT.stringof;
	else static if (isIntegral!FT)
		enum javaType = FT.sizeof == 8 ? "Long" : "Integer";
	else static if (isBoolean!FT)
		enum javaType = "Boolean";
	else static if (isSomeString!FT)
		enum javaType = "String";
	else static if (isAssociativeArray!FT)
		enum javaType = "Map<String, " ~ javaType!(ValueType!FT) ~ ">";
	else static if (isArray!FT)
		enum javaType = "List<" ~ javaType!(ForeachType!FT) ~ ">";
	else static if (is(FT == struct))
		enum javaType = FT.stringof;
	else
		static assert(false, "javagen: unsupported field type " ~ FT.stringof);
}

/// A Javadoc block for `text`, or "" when there is none.
private string javadoc(string text, string prefix)
{
	if (!text.length)
		return "";
	return prefix ~ "/**\n" ~ text.split("\n").map!(line => prefix ~ " * " ~ line).join("\n")
		~ "\n" ~ prefix ~ " */\n";
}

private string fileHeader(string[] imports)
{
	string s = banner ~ "package " ~ javaPackage ~ ";\n\n";
	foreach (name; imports)
		s ~= "import " ~ name ~ ";\n";
	return imports.length ? s ~ "\n" : s;
}

/// `public enum E` with the wire value behind `@JsonValue` and a lenient `@JsonCreator`
/// that answers the first member for an unknown value, like `CrdPolicy` does in D.
string emitJavaEnum(E)()
{
	enum name = E.stringof;
	string s = fileHeader(["com.fasterxml.jackson.annotation.JsonCreator",
		"com.fasterxml.jackson.annotation.JsonValue"]);
	s ~= "public enum " ~ name ~ " {\n";
	string[] constants;
	static foreach (member; EnumMembers!E)
		constants ~= indent ~ javaConstant(cast(string) member) ~ "(\"" ~ cast(string) member ~ "\")";
	s ~= constants.join(",\n") ~ ";\n\n";
	s ~= indent ~ "private final String wire;\n\n";
	s ~= indent ~ name ~ "(String wire) {\n" ~ indent ~ indent ~ "this.wire = wire;\n" ~ indent ~ "}\n\n";
	s ~= indent ~ "@JsonValue\n" ~ indent ~ "public String wire() {\n" ~ indent ~ indent
		~ "return wire;\n" ~ indent ~ "}\n\n";
	s ~= indent ~ "/** The member for a wire value; an unknown value answers the first member, the server's default. */\n";
	s ~= indent ~ "@JsonCreator\n" ~ indent ~ "public static " ~ name ~ " fromWire(String wire) {\n";
	s ~= indent ~ indent ~ "for (" ~ name ~ " member : values()) {\n";
	s ~= indent ~ indent ~ indent ~ "if (member.wire.equals(wire)) {\n";
	s ~= indent ~ indent ~ indent ~ indent ~ "return member;\n";
	s ~= indent ~ indent ~ indent ~ "}\n" ~ indent ~ indent ~ "}\n";
	s ~= indent ~ indent ~ "return values()[0];\n" ~ indent ~ "}\n}\n";
	return s;
}

/// The type of the `spec` or `status` field of kind `T`, or "Void" when it has none.
private template kindPart(T, string part)
{
	static if (__traits(hasMember, T, part))
		enum kindPart = javaType!(typeof(__traits(getMember, T, part)));
	else
		enum kindPart = "Void";
}

/// A kind: fabric8 `CustomResource` subclass with the CRD's group, version, plural and short names.
string emitJavaKind(T)()
{
	enum name = T.stringof;
	string s = fileHeader(["io.fabric8.kubernetes.api.model.Namespaced",
		"io.fabric8.kubernetes.client.CustomResource", "io.fabric8.kubernetes.model.annotation.Group",
		"io.fabric8.kubernetes.model.annotation.Plural", "io.fabric8.kubernetes.model.annotation.ShortNames",
		"io.fabric8.kubernetes.model.annotation.Version"]);
	s ~= javadoc(descriptionOf!T, "");
	s ~= "@Group(\"" ~ crGroup ~ "\")\n@Version(\"" ~ crVersion ~ "\")\n";
	s ~= "@Plural(\"" ~ pluralOf!T ~ "\")\n";
	s ~= "@ShortNames({" ~ shortNamesOf!T.map!(short_ => "\"" ~ short_ ~ "\"").join(", ") ~ "})\n";
	s ~= "public class " ~ name ~ " extends CustomResource<" ~ kindPart!(T, "spec") ~ ", "
		~ kindPart!(T, "status") ~ "> implements Namespaced {\n}\n";
	return s;
}

/// The `<Kind>List` type fabric8 needs to list a kind.
string emitJavaList(T)()
{
	enum name = T.stringof;
	return fileHeader(["io.fabric8.kubernetes.api.model.DefaultKubernetesResourceList"])
		~ "/** A list of " ~ name ~ " resources. */\n"
		~ "public class " ~ name ~ "List extends DefaultKubernetesResourceList<" ~ name ~ "> {\n}\n";
}

/// A plain struct: Jackson bean with wire names, getters and setters, equals, hashCode and toString.
string emitJavaClass(T)()
{
	enum name = T.stringof;
	string fields, accessors, equalsTerms, hashTerms, toStringTerms;
	string[] fieldNames;
	static foreach (property; describe!T.properties)
	{{
		alias member = __traits(getMember, T, property.name);
		enum wire = jsonNameOf!member;
		enum field = javaField(wire);
		enum type = javaType!(typeof(member));
		enum accessor = javaAccessor(wire);
		enum requiredNote = isRequired!member ? "Required." : "";
		enum description = descriptionOf!member;
		enum doc = description.length && requiredNote.length ? description ~ " " ~ requiredNote
			: description ~ requiredNote;
		fieldNames ~= field;
		fields ~= javadoc(doc, indent) ~ indent ~ "@JsonProperty(\"" ~ wire ~ "\")\n"
			~ indent ~ "private " ~ type ~ " " ~ field ~ ";\n\n";
		accessors ~= indent ~ "public " ~ type ~ " get" ~ accessor ~ "() {\n" ~ indent ~ indent
			~ "return " ~ field ~ ";\n" ~ indent ~ "}\n\n";
		accessors ~= indent ~ "public void set" ~ accessor ~ "(" ~ type ~ " " ~ field ~ ") {\n"
			~ indent ~ indent ~ "this." ~ field ~ " = " ~ field ~ ";\n" ~ indent ~ "}\n\n";
	}}
	string[] imports = ["com.fasterxml.jackson.annotation.JsonInclude",
		"com.fasterxml.jackson.annotation.JsonProperty"];
	if (fields.canFind(" JsonNode ") || fields.canFind("<JsonNode>"))
		imports = ["com.fasterxml.jackson.annotation.JsonInclude",
			"com.fasterxml.jackson.annotation.JsonProperty", "com.fasterxml.jackson.databind.JsonNode"];
	if (fields.canFind("List<"))
		imports ~= "java.util.List";
	if (fields.canFind("Map<"))
		imports ~= "java.util.Map";
	imports ~= "java.util.Objects";

	string s = fileHeader(imports) ~ javadoc(descriptionOf!T, "");
	s ~= "@JsonInclude(JsonInclude.Include.NON_NULL)\npublic class " ~ name ~ " {\n" ~ fields ~ accessors;
	s ~= indent ~ "@Override\n" ~ indent ~ "public boolean equals(Object other) {\n";
	s ~= indent ~ indent ~ "return other instanceof " ~ name ~ " that\n";
	s ~= fieldNames.map!(field => indent ~ indent ~ indent ~ "&& Objects.equals(" ~ field ~ ", that." ~ field ~ ")").join("\n");
	s ~= ";\n" ~ indent ~ "}\n\n";
	s ~= indent ~ "@Override\n" ~ indent ~ "public int hashCode() {\n" ~ indent ~ indent
		~ "return Objects.hash(" ~ fieldNames.join(", ") ~ ");\n" ~ indent ~ "}\n\n";
	s ~= indent ~ "@Override\n" ~ indent ~ "public String toString() {\n" ~ indent ~ indent
		~ "return \"" ~ name ~ "{\"\n";
	s ~= fieldNames.map!((field) {
		return indent ~ indent ~ indent ~ "+ \"" ~ field ~ "=\" + " ~ field;
	}).join(" + \", \"\n");
	s ~= "\n" ~ indent ~ indent ~ indent ~ "+ \"}\";\n" ~ indent ~ "}\n}\n";
	return s;
}

/// `ApiGroup` constants: the Java twin of the TS `GROUP` / `VERSION` exports.
private string emitJavaApiGroup()
{
	return fileHeader([]) ~ "/** The API group and version every resource in this package is served at. */\n"
		~ "public final class ApiGroup {\n"
		~ indent ~ "public static final String GROUP = \"" ~ crGroup ~ "\";\n\n"
		~ indent ~ "public static final String VERSION = \"" ~ crVersion ~ "\";\n\n"
		~ indent ~ "public static final String API_VERSION = \"" ~ crApiVersion ~ "\";\n\n"
		~ indent ~ "private ApiGroup() {\n" ~ indent ~ "}\n}\n";
}

/// Every generated Java file, keyed by file name.
string[string] emitJavaTypes()
{
	string[string] files;
	files["ApiGroup.java"] = emitJavaApiGroup();
	static foreach (E; CrdEnums)
		files[E.stringof ~ ".java"] = emitJavaEnum!E();
	static foreach (T; CrdStructs)
	{
		static if (isKind!T)
		{
			files[T.stringof ~ ".java"] = emitJavaKind!T();
			files[T.stringof ~ "List.java"] = emitJavaList!T();
		}
		else static if (!is(T == ObjectMeta))
			files[T.stringof ~ ".java"] = emitJavaClass!T();
	}
	return files;
}

version (unittest) import fluent.asserts;

unittest // wire names become Java constants, fields and accessor suffixes
{
	[javaConstant("stream-json"), javaConstant("tool_call"), javaConstant("Succeeded"), javaConstant("auto")]
		.should.equal(["STREAM_JSON", "TOOL_CALL", "SUCCEEDED", "AUTO"]);
	[javaField("headers_secret"), javaField("prUrl"), javaField("ref"), javaField("default")]
		.should.equal(["headersSecret", "prUrl", "ref", "default_"]);
	javaAccessor("headers_secret").should.equal("HeadersSecret");
}

@safe unittest // javaType boxes scalars and maps collections to java.util types
{
	import agentcore.crds.enums : SinkType;
	import agentcore.crds.env_var : EnvVar;

	static assert(javaType!Json == "JsonNode");
	static assert(javaType!SinkType == "SinkType");
	static assert(javaType!int == "Integer");
	static assert(javaType!long == "Long");
	static assert(javaType!bool == "Boolean");
	static assert(javaType!(string[string]) == "Map<String, String>");
	static assert(javaType!(EnvVar[]) == "List<EnvVar>");
}

unittest // an enum carries the wire value and falls back to the first member
{
	import agentcore.crds.enums : OutputFormat;

	const source = emitJavaEnum!OutputFormat();
	[source.canFind("    STREAM_JSON(\"stream-json\");"), source.canFind("@JsonValue"),
		source.canFind("return values()[0];")].should.equal([true, true, true]);
}

unittest // a kind extends CustomResource with its spec and status and gets a List
{
	import agentcore.crds.agent : Agent;
	import agentcore.crds.agent_definition : AgentDefinition;

	emitJavaKind!Agent().should.contain(
		"@Group(\"agents.re-cinq.com\")\n@Version(\"v1beta1\")\n@Plural(\"agents\")\n@ShortNames({\"agt\"})\n"
		~ "public class Agent extends CustomResource<AgentSpec, AgentStatus> implements Namespaced {");
	emitJavaKind!AgentDefinition().should.contain("CustomResource<AgentDefinitionSpec, Void>");
	emitJavaList!Agent().should.contain("public class AgentList extends DefaultKubernetesResourceList<Agent>");
}

unittest // a struct is a Jackson bean with wire names, boxed defaults and value semantics
{
	import agentcore.crds.station_spec : StationSpec;
	import agentcore.crds.secret_ref : SecretRef;

	const station = emitJavaClass!StationSpec();
	[station.canFind("@JsonInclude(JsonInclude.Include.NON_NULL)"),
		station.canFind("    @JsonProperty(\"deadlineMinutes\")\n    private Integer deadlineMinutes;"),
		station.canFind("    @JsonProperty(\"template\")\n    private JsonNode template;"),
		station.canFind("import com.fasterxml.jackson.databind.JsonNode;"),
		station.canFind("&& Objects.equals(deadlineMinutes, that.deadlineMinutes)")]
		.should.equal([true, true, true, true, true]);
	emitJavaClass!SecretRef().should.contain(
		"    /**\n     * Allowlisted secret-store key. Required.\n     */\n    @JsonProperty(\"ref\")\n    private String ref;");
}

unittest // the file set covers ApiGroup, every enum, every struct but ObjectMeta, and a List per kind
{
	const files = emitJavaTypes();
	enum kinds = CrdKinds.length;
	enum structs = CrdStructs.length - 1;
	enum enums = CrdEnums.length;
	files.length.should.equal(1 + enums + structs + kinds);
	[("AgentSpawnerList.java" in files) !is null, ("ObjectMeta.java" in files) !is null].should.equal([true, false]);
}
