# syntax=docker/dockerfile:1
#
# The controller image (ghcr.io/re-cinq/ai-agent-controller). Multi-stage: build
# the controller with the official ldc (static druntime, like the agent image),
# then a minimal glibc runtime with libssl3 (vibe-d links it dynamically). Runs
# non-root, matching deploy/controller.yaml's securityContext.
#
# Builds for linux/amd64 and linux/arm64: BuildKit's TARGETARCH picks the LDC
# tarball, and each platform compiles natively (no cross-compile flags).
#
# Builder: rockylinux:9 — its glibc (2.34) is the oldest in the runtime/Station
# matrix (rocky/amazonlinux/debian/ubuntu), so the static-druntime binary it builds
# runs on every glibc >= 2.34, not just bookworm's 2.36. The OFFICIAL ldc release
# (dlang.org install.sh) ships the static druntime/phobos that
# `-link-defaultlib-shared=false` needs — the EPEL ldc package ships only shared.
#
ARG BUILDER_IMAGE=rockylinux:9
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG LDC_VERSION=1.40.0
ARG LDC_SHA256_AMD64=0da61ed2ea96583aa0ccbeb00f8d78983b23d1e87b84a6f2098eb12059475b27
ARG LDC_SHA256_ARM64=28d183a99ab9f0790f5597c5c125f41338390f8bed5ed3164138958c18479c82

FROM ${BUILDER_IMAGE} AS builder
ARG TARGETARCH
ARG LDC_VERSION
ARG LDC_SHA256_AMD64
ARG LDC_SHA256_ARM64
RUN set -eu; \
	dnf install -y --setopt=install_weak_deps=False \
		curl-minimal xz tar gzip gcc lld glibc-devel zlib-devel openssl-devel libxml2 git ca-certificates; \
	dnf clean all
# Pinned, checksum-verified official LDC release tarball — no curl|bash of an
# unverified installer. The version and the per-arch hashes move together.
RUN set -eu; \
	case "${TARGETARCH}" in \
		amd64) ldc_arch=x86_64;  ldc_sha="${LDC_SHA256_AMD64}" ;; \
		arm64) ldc_arch=aarch64; ldc_sha="${LDC_SHA256_ARM64}" ;; \
		*) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
	esac; \
	tarball="ldc2-${LDC_VERSION}-linux-${ldc_arch}.tar.xz"; \
	curl -fsSL -o "/tmp/${tarball}" \
		"https://github.com/ldc-developers/ldc/releases/download/v${LDC_VERSION}/${tarball}"; \
	echo "${ldc_sha}  /tmp/${tarball}" | sha256sum -c -; \
	mkdir -p /opt/dlang; \
	tar -C /opt/dlang -xf "/tmp/${tarball}"; \
	ln -s "/opt/dlang/ldc2-${LDC_VERSION}-linux-${ldc_arch}" /opt/dlang/ldc2; \
	rm -f "/tmp/${tarball}"
ENV PATH="/opt/dlang/ldc2/bin:${PATH}"
WORKDIR /src
COPY . .
# Linked with lld, not Rocky 9's ld.bfd: binutils 2.35 predates SHF_GNU_RETAIN and
# splits .tbss, so thread-locals alias (see scripts/check-tbss.sh). DFLAGS replaces
# dub's build-type flags, so these are the complete compiler flags.
RUN DFLAGS="-link-defaultlib-shared=false -L-lz --linker=lld" dub build :controller --compiler=ldc2
RUN scripts/check-tbss.sh packages/controller/ai-agent-controller

FROM ${RUNTIME_IMAGE} AS runtime
RUN set -eu; \
	export DEBIAN_FRONTEND=noninteractive; \
	apt-get update; \
	apt-get install -y --no-install-recommends ca-certificates libssl3; \
	rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/packages/controller/ai-agent-controller /usr/local/bin/ai-agent-controller
USER 1000
ENTRYPOINT ["/usr/local/bin/ai-agent-controller"]
