{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "agentImage", "cli", "batch", "modelCatalog", "realtime", "webhooks"],
  "definitions": {
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    }
  },
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "digest"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[^@:]+(:[0-9]+)?(/[^@:]+)*$" },
            "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "agentImage": { "type": "string", "pattern": "^[^@]+@sha256:[0-9a-f]{64}$" },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex", "gemini", "opencode"],
      "properties": {
        "claude": { "type": "string", "minLength": 1 },
        "codex": { "type": "string", "minLength": 1 },
        "gemini": { "type": "string", "minLength": 1 },
        "opencode": { "type": "string", "minLength": 1 }
      }
    },
    "batch": { "$ref": "#/definitions/toggle" },
    "modelCatalog": { "$ref": "#/definitions/toggle" },
    "realtime": { "$ref": "#/definitions/toggle" },
    "webhooks": { "$ref": "#/definitions/toggle" }
  }
}
